</style>
</head>

<body>

<div class="container">

    <h1>🍱 抬餐人員排班表</h1>

    <div class="description">
        每天 4 人・自動跳過未用餐同學
    </div>

    <div class="setting">

        <h2>⚙️ 排班設定</h2>

        <label>
            <strong>星期一第一位：</strong>
            <select id="startNumber"></select>
        </label>

        <div class="excluded">
            不排號碼：21、27、28
        </div>

        <h2 style="margin-top:25px;">📅 放假設定</h2>

        <div class="holiday-list">

            <label class="holiday">
                <input type="checkbox" id="mon">
                星期一放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="tue">
                星期二放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="wed">
                星期三放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="thu">
                星期四放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="fri">
                星期五放假
            </label>

        </div>

        <button onclick="generateSchedule()">
            🔄 重新排班
        </button>

    </div>

    <div class="schedule">

        <h2>📋 本週抬餐人員</h2>

        <table>

            <thead>
                <tr>
                    <th>星期</th>
                    <th>第一位</th>
                    <th>第二位</th>
                    <th>第三位</th>
                    <th>第四位</th>
                </tr>
            </thead>

            <tbody id="scheduleBody">
            </tbody>

        </table>

        <button class="print-btn" onclick="window.print()">
            🖨️ 列印排班表
        </button>

    </div>

</div>


<script>

    // 班級號碼
    const allNumbers = [];

    for (let i = 1; i <= 34; i++) {
        allNumbers.push(i);
    }

    // 不吃飯的學生
    const excludedNumbers = [21, 27, 28];

    // 實際可以排班的人
    const availableNumbers = allNumbers.filter(
        number => !excludedNumbers.includes(number)
    );

    // 星期
    const weekdays = [
        { name: "星期一", id: "mon" },
        { name: "星期二", id: "tue" },
        { name: "星期三", id: "wed" },
        { name: "星期四", id: "thu" },
        { name: "星期五", id: "fri" }
    ];


    // 建立下拉選單
    const startSelect = document.getElementById("startNumber");

    availableNumbers.forEach(number => {

        const option = document.createElement("option");

        option.value = number;
        option.textContent = number + " 號";

        startSelect.appendChild(option);

    });


    // 取得下一個可以排班的號碼
    function getNextNumber(currentIndex) {

        let nextIndex = currentIndex + 1;

        // 超過最後一個就從頭開始
        if (nextIndex >= availableNumbers.length) {
            nextIndex = 0;
        }

        return nextIndex;
    }


    // 產生排班
    function generateSchedule() {

        const startNumber = parseInt(startSelect.value);

        // 找到星期一第一位在陣列中的位置
        let currentIndex = availableNumbers.indexOf(startNumber);

        const tbody = document.getElementById("scheduleBody");

        tbody.innerHTML = "";


        weekdays.forEach(day => {

            const isHoliday =
                document.getElementById(day.id).checked;

            const row = document.createElement("tr");


            // 如果放假
            if (isHoliday) {

                row.classList.add("holiday-row");

                row.innerHTML = `
                    <td><strong>${day.name}</strong></td>
                    <td colspan="4">🎉 放假，不排班</td>
                `;

            }

            // 正常上課
            else {

                let people = [];

                // 每天四個人
                for (let i = 0; i < 4; i++) {

                    people.push(
                        availableNumbers[currentIndex]
                    );

                    currentIndex = getNextNumber(currentIndex);

                }


                row.innerHTML = `
                    <td><strong>${day.name}</strong></td>

                    <td>
                        <span class="number">${people[0]}</span>
                    </td>

                    <td>
                        <span class="number">${people[1]}</span>
                    </td>

                    <td>
                        <span class="number">${people[2]}</span>
                    </td>

                    <td>
                        <span class="number">${people[3]}</span>
                    </td>
                `;

            }

            tbody.appendChild(row);

        });

    }


    // 預設產生一次
    generateSchedule();

</script>

</body>
</html>
