<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>班級抬餐排班表</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 20px;
        font-family:
            "Microsoft JhengHei",
            "Noto Sans TC",
            Arial,
            sans-serif;
        background: #f3f6fa;
        color: #333;
    }

    .container {
        max-width: 900px;
        margin: auto;
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    }

    h1 {
        text-align: center;
        margin: 0;
        color: #263238;
        font-size: 32px;
    }

    .subtitle {
        text-align: center;
        color: #777;
        margin: 8px 0 30px;
    }

    .box {
        background: #f8fafc;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .box-title {
        font-size: 21px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .select-area {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    select {
        font-size: 18px;
        padding: 10px 15px;
        border: 2px solid #d5dce3;
        border-radius: 10px;
        background: white;
        cursor: pointer;
    }

    .excluded {
        margin-top: 15px;
        padding: 12px;
        border-radius: 10px;
        background: #fff3f3;
        color: #d63031;
        font-weight: bold;
    }

    .holiday-list {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
    }

    .holiday {
        background: white;
        border: 2px solid #e1e6eb;
        border-radius: 12px;
        padding: 14px 8px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .holiday:hover {
        border-color: #3498db;
    }

    .holiday input {
        width: 18px;
        height: 18px;
        vertical-align: middle;
        margin-right: 5px;
        cursor: pointer;
    }

    .buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    button {
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
    }

    .generate {
        background: #3498db;
        color: white;
    }

    .generate:hover {
        background: #2980b9;
    }

    .copy {
        background: #27ae60;
        color: white;
    }

    .copy:hover {
        background: #219150;
    }

    .print {
        background: #7f8c8d;
        color: white;
        width: 100%;
        margin-top: 15px;
    }

    .print:hover {
        background: #636e72;
    }

    .schedule-title {
        font-size: 23px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
        overflow: hidden;
        border-radius: 12px;
    }

    th {
        background: #34495e;
        color: white;
        padding: 15px 8px;
        font-size: 17px;
    }

    td {
        border: 1px solid #ddd;
        padding: 14px 8px;
        text-align: center;
        font-size: 17px;
    }

    tr:nth-child(even) {
        background: #f8f9fa;
    }

    .day {
        font-weight: bold;
    }

    .number {
        display: inline-flex;
        justify-content: center;
        align-items: center;

        width: 45px;
        height: 45px;

        border-radius: 50%;

        background: #3498db;
        color: white;

        font-size: 19px;
        font-weight: bold;

        margin: 2px;
    }

    .holiday-row {
        background: #fff0f0 !important;
        color: #e74c3c;
        font-weight: bold;
    }

    .holiday-text {
        font-size: 18px;
    }

    .info {
        text-align: center;
        margin-top: 20px;
        color: #777;
        font-size: 14px;
    }

    .success-message {
        display: none;
        text-align: center;
        color: #27ae60;
        font-weight: bold;
        margin-top: 10px;
    }

    @media (max-width: 650px) {

        body {
            padding: 10px;
        }

        .container {
            padding: 20px 15px;
        }

        h1 {
            font-size: 26px;
        }

        .holiday-list {
            grid-template-columns: 1fr 1fr;
        }

        .buttons {
            grid-template-columns: 1fr;
        }

        .number {
            width: 38px;
            height: 38px;
            font-size: 16px;
        }
    }

    @media print {

        body {
            background: white;
            padding: 0;
        }

        .container {
            box-shadow: none;
            max-width: 100%;
        }

        .setting-box,
        .buttons,
        .print,
        .info {
            display: none !important;
        }

        h1 {
            margin-top: 20px;
        }

        table {
            min-width: 100%;
        }
    }
</style>
</head>


<body>

<div class="container">

    <h1>🍱 班級抬餐人員排班表</h1>

    <div class="subtitle">
        每天 4 人・自動跳過不吃飯同學
    </div>


    <!-- =========================
         排班設定
    ========================== -->

    <div class="box setting-box">

        <div class="box-title">
            ⚙️ 排班設定
        </div>

        <div class="select-area">

            <strong>星期一第一位：</strong>

            <select id="startNumber">
            </select>

            <span>號</span>

        </div>


        <div class="excluded">
            🚫 不排班：21號、27號、28號
        </div>


        <div class="box-title" style="margin-top:25px;">
            📅 放假設定
        </div>


        <div class="holiday-list">

            <label class="holiday">
                <input type="checkbox" id="mon">
                星期一放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="tue">
                星期二放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="wed">
                星期三放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="thu">
                星期四放假
            </label>

            <label class="holiday">
                <input type="checkbox" id="fri">
                星期五放假
            </label>

        </div>

    </div>


    <!-- =========================
         按鈕
    ========================== -->

    <div class="box setting-box">

        <div class="buttons">

            <button
                class="generate"
                onclick="generateSchedule()">
                🔄 重新排班
            </button>

            <button
                class="copy"
                onclick="copySchedule()">
                📋 複製排班結果
            </button>

        </div>

        <div
            id="successMessage"
            class="success-message">
            ✓ 已複製排班結果！
        </div>

    </div>


    <!-- =========================
         排班結果
    ========================== -->

    <div>

        <div class="schedule-title">
            📋 本週抬餐人員
        </div>


        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>
                        <th>星期</th>
                        <th>第 1 位</th>
                        <th>第 2 位</th>
                        <th>第 3 位</th>
                        <th>第 4 位</th>
                    </tr>

                </thead>


                <tbody id="scheduleBody">

                </tbody>

            </table>

        </div>


        <button
            class="print"
            onclick="window.print()">
            🖨️ 列印排班表
        </button>

    </div>


    <div class="info">
        21、27、28號不參與抬餐排班
    </div>

</div>


<script>

/* =========================================
   基本資料
========================================= */

// 全班 1～34 號
const allNumbers = [];

for (let i = 1; i <= 34; i++) {
    allNumbers.push(i);
}


// 不吃飯、不參與排班的人
const excludedNumbers = [21, 27, 28];


// 真正可以排班的人
const availableNumbers = allNumbers.filter(
    number => !excludedNumbers.includes(number)
);


// 星期資料
const weekdays = [
    {
        name: "星期一",
        id: "mon"
    },
    {
        name: "星期二",
        id: "tue"
    },
    {
        name: "星期三",
        id: "wed"
    },
    {
        name: "星期四",
        id: "thu"
    },
    {
        name: "星期五",
        id: "fri"
    }
];


/* =========================================
   建立號碼下拉選單
========================================= */

const startSelect =
    document.getElementById("startNumber");


availableNumbers.forEach(number => {

    const option =
        document.createElement("option");

    option.value = number;

    option.textContent =
        number + "號";

    startSelect.appendChild(option);

});


/* =========================================
   讀取上次設定
========================================= */

const savedStart =
    localStorage.getItem("startNumber");

if (savedStart &&
    availableNumbers.includes(Number(savedStart))) {

    startSelect.value = savedStart;

}


weekdays.forEach(day => {

    const checkbox =
        document.getElementById(day.id);

    const saved =
        localStorage.getItem("holiday_" + day.id);

    if (saved === "true") {
        checkbox.checked = true;
    }

});


/* =========================================
   找下一個號碼
========================================= */

function getNextIndex(index) {

    index++;

    if (index >= availableNumbers.length) {
        index = 0;
    }

    return index;

}


/* =========================================
   產生排班
========================================= */

function generateSchedule() {

    const startNumber =
        Number(startSelect.value);


    // 儲存目前的起始號碼
    localStorage.setItem(
        "startNumber",
        startNumber
    );


    // 儲存放假設定
    weekdays.forEach(day => {

        const checkbox =
            document.getElementById(day.id);

        localStorage.setItem(
            "holiday_" + day.id,
            checkbox.checked
        );

    });


    // 找到起始號碼的位置
    let currentIndex =
        availableNumbers.indexOf(startNumber);


    const tbody =
        document.getElementById("scheduleBody");


    // 清空舊結果
    tbody.innerHTML = "";


    // 產生星期一～星期五
    weekdays.forEach(day => {

        const isHoliday =
            document.getElementById(day.id).checked;


        const row =
            document.createElement("tr");


        /* =========================
           如果放假
        ========================== */

        if (isHoliday) {

            row.classList.add("holiday-row");

            row.innerHTML = `

                <td class="day">
                    ${day.name}
                </td>

                <td colspan="4">
                    <span class="holiday-text">
                        🎉 放假・不用抬餐
                    </span>
                </td>

            `;

        }


        /* =========================
           正常上課
        ========================== */

        else {

            const people = [];


            // 一天四個人
            for (let i = 0; i < 4; i++) {

                people.push(
                    availableNumbers[currentIndex]
                );

                currentIndex =
                    getNextIndex(currentIndex);

            }


            row.innerHTML = `

                <td class="day">
                    ${day.name}
                </td>

                <td>
                    <span class="number">
                        ${people[0]}
                    </span>
                </td>

                <td>
                    <span class="number">
                        ${people[1]}
                    </span>
                </td>

                <td>
                    <span class="number">
                        ${people[2]}
                    </span>
                </td>

                <td>
                    <span class="number">
                        ${people[3]}
                    </span>
                </td>

            `;

        }


        tbody.appendChild(row);

    });

}


/* =========================================
   複製排班結果
========================================= */

function copySchedule() {

    let text = "";

    text += "🍱 班級抬餐人員排班表\n";
    text += "====================\n";


    weekdays.forEach(day => {

        const checkbox =
            document.getElementById(day.id);


        if (checkbox.checked) {

            text +=
                day.name +
                "：🎉 放假\n";

        }

        else {

            // 找目前表格中的資料
            const row =
                document.querySelector(
                    "#scheduleBody tr:nth-child(" +
                    (weekdays.indexOf(day) + 1) +
                    ")"
                );


            const numbers =
                row.querySelectorAll(".number");


            const people = [];

            numbers.forEach(number => {

                people.push(
                    number.textContent.trim()
                );

            });


            text +=
                day.name +
                "：" +
                people.join("、") +
                "號\n";

        }

    });


    text += "====================\n";
    text += "不排班：21、27、28號";


    navigator.clipboard.writeText(text)
        .then(() => {

            const message =
                document.getElementById(
                    "successMessage"
                );

            message.style.display = "block";


            setTimeout(() => {

                message.style.display = "none";

            }, 2000);

        })
        .catch(() => {

            alert(
                "複製失敗，請直接選取排班表複製。"
            );

        });

}


/* =========================================
   勾選放假後自動更新
========================================= */

weekdays.forEach(day => {

    const checkbox =
        document.getElementById(day.id);


    checkbox.addEventListener(
        "change",
        generateSchedule
    );

});


/* =========================================
   更改星期一第一位時自動更新
========================================= */

startSelect.addEventListener(
    "change",
    generateSchedule
);


/* =========================================
   網頁第一次開啟
========================================= */

generateSchedule();

</script>

</body>
</html>
